# ============================================================
# Vanna MCP Server — 环境变量配置示例
# 复制本文件为 .env 并修改为实际值后使用
# ============================================================

# === 数据库配置 ===
# 数据库类型: mysql | postgresql | highgo | dm
DB_TYPE=highgo

# 数据库主机地址
DB_HOST=127.0.0.1

# 数据库端口（各数据库默认端口不同）
#   MySQL:      3306
#   PostgreSQL: 5432
#   HighGo:     5866
#   达梦(DM):    5236
DB_PORT=5866

# 数据库名称（达梦中为 schema 名）
DB_NAME=highgo

# 数据库用户名（各数据库默认用户不同）
#   MySQL:      root
#   PostgreSQL: postgres
#   HighGo:     sysdba
#   达梦(DM):    SYSDBA
DB_USER=sysdba

# 数据库密码
DB_PASSWORD=your_password_here

# === LLM 配置 ===
# 使用的 LLM 模型名称（需与 OpenAI API 兼容）
LLM_MODEL=gpt-4

# OpenAI API Key（或其他兼容 LLM 的 API Key）
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI 兼容 API 的 Base URL（可选）
# 设置后可访问任意 OpenAI 兼容的大模型服务，如 DeepSeek、智谱、通义千问、Ollama 等
# 不设置时默认使用 OpenAI 官方 API (https://api.openai.com/v1)
# 示例:
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
#   智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   通义千问:    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: LLM_BASE_URL=http://localhost:11434/v1
#   vLLM 本地:   LLM_BASE_URL=http://localhost:8000/v1
# LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 请求温度（可选，默认 0.7）
# LLM_TEMPERATURE=0.7

# === 向量存储配置 ===
# ChromaDB 持久化存储路径（用于 RAG 训练数据）
# 未设置时自动按数据库类型隔离: ./chromadb_data_{db_type}
# 例如 DB_TYPE=highgo 时路径为 ./chromadb_data_highgo
# 建议显式设置以确保路径可控
CHROMADB_PATH=./chromadb_data

# === MCP Server 配置 ===
# 服务监听地址
MCP_HOST=0.0.0.0

# 服务监听端口
MCP_PORT=8000

# uvicorn worker 数量（仅在使用 uvicorn 启动时生效）
# 生产环境建议设置为 CPU 核心数 × 2
# MCP_WORKERS=4

# === 高级配置（可选）===

# YAML 配置文件路径（设置后优先于环境变量加载配置）
# CONFIG_YAML_PATH=config.yaml

# 模拟模式（设为 1 时不初始化 Vanna 实例，用于接口测试）
# VANNA_MOCK_MODE=0

# === 瀚高 SM3 国密认证说明 ===
# 瀚高数据库的 SM3 认证由瀚高定制版 libpq 在 C 层自动处理，
# 无需在环境变量中额外配置认证参数。
# 前提条件：
#   1. 已安装瀚高定制版 psycopg2（非 PyPI 标准版）
#   2. 已安装瀚高定制版 libpq.so.5
#   3. LD_LIBRARY_PATH 指向瀚高 libpq 路径
# 驱动下载: https://pan.baidu.com/s/1xuz6uJz0utRgKWecXhpOiA?pwd=o0tj
